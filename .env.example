# Repo-root .env — copy to .env (gitignored) and fill in.
# Variables here are picked up automatically by `docker compose` and
# substituted into service environment blocks in docker-compose.yml.
#
# Add ONE value here; every service that needs it picks it up.

# ── LLM provider keys (planning + messaging) ────────────────────
# LiteLLM uses one of these based on each service's LLM_MODEL setting.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── RabbitMQ credentials (used by all services) ─────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ── Postgres credentials (orchestrator) ─────────────────────────
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=email_outreach

# ── Host ports (override only if these conflict on your machine) ─
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MONGO_HOST_PORT=27017
POSTGRES_HOST_PORT=5433
