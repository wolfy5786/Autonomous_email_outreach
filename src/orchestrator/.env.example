# Orchestrator — TypeScript/Express service (see src/orchestrator/config/index.ts).
# Copy to .env and adjust. `.env` is gitignored.

# HTTP server
PORT=3000
LOG_LEVEL=info

# Broker — RabbitMQ Docker service (see repo root docker-compose.yml).
# From inside Compose, use hostname ``rabbitmq``; on the host use ``localhost``.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=email_outreach.events

# Shared MongoDB (campaign state)
MONGO_URI=mongodb://mongo:27017/email_outreach

# Per-campaign pipeline status (orchestrator_service_role.md §2.1).
# From inside Compose, use hostname ``postgres``; on the host use ``localhost:5433``.
POSTGRES_URL=postgres://orchestrator:orchestrator@postgres:5432/email_outreach

# Retry policy for downstream message dispatch
RETRY_LIMIT=3
