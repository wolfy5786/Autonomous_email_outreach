{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0"
  },
  "include": ["./**/*", "../local_infrastructure/**/*", "../shared/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "../local_infrastructure/rabbit_mq/rabbitmq.broker.ts",
    "../local_infrastructure/rabbit_mq/sqs.broker.ts"
  ]
}
