# AMQP — broker is the RabbitMQ Docker service (see repo root docker-compose.yml).
# From inside Compose, use hostname ``rabbitmq``; on the host use ``localhost``.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBIT_PREFETCH=10
LOG_LEVEL=INFO

# Shared MongoDB (Beanie / Motor — see shared.models.db.init_db)
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=email_outreach

# Product Hunt API v2 (GraphQL) — https://api.producthunt.com/v2/docs
# PRODUCT_HUNT_TOKEN=
# PRODUCT_HUNT_DEVELOPER_TOKEN=
# PRODUCT_HUNT_API_URL=https://api.producthunt.com/v2/api/graphql
# PRODUCT_HUNT_PAGE_SIZE=20
# PRODUCT_HUNT_MAX_PAGES=5
# PRODUCT_HUNT_LOOKBACK_DAYS=180
# PRODUCT_HUNT_TOPIC=developer-tools
# PRODUCT_HUNT_POSTED_BEFORE=2025-01-01T00:00:00Z
# PRODUCT_HUNT_POSTED_BEFORE_DAYS=30
# PRODUCT_HUNT_MIN_UPVOTES=0
# PRODUCT_HUNT_ORDER=VOTES
# PRODUCT_HUNT_REQUEST_TIMEOUT_S=20
# PRODUCT_HUNT_MIN_INTERVAL_S=1.0
# PRODUCT_HUNT_MAX_RETRIES_429=1
