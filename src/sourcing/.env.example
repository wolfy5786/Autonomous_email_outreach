# Message broker: rabbitmq (only supported value for now)
BROKER_TYPE=rabbitmq

# AMQP URL (path / is encoded as %2F for the default vhost)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F

# Optional: connection retry (used by RabbitmqBroker)
# RABBITMQ_CONNECT_RETRIES=30
# RABBITMQ_CONNECT_BACKOFF_S=2.0

# Shared MongoDB (Beanie / Motor — see shared.models.db.init_db)
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB_NAME=email_outreach
