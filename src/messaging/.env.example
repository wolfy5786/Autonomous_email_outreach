# Broker
BROKER_TYPE=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=email_outreach.events
RABBIT_PREFETCH=5

# Mongo
MONGO_URL=mongodb://mongo:27017
MONGO_DB=email_outreach

# Queues
MESSAGING_REQUESTED_QUEUE=messaging.requested
DRAFT_WRITTEN_QUEUE=draft.written
DRAFT_FAILED_QUEUE=draft.failed

# LLM — provider-prefixed model string, see https://docs.litellm.ai/docs/providers
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Provider keys — LiteLLM picks the right one based on LLM_MODEL prefix
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Email provider
EMAIL_PROVIDER=stub                      # stub | gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Per-campaign tokens are read at runtime via:
#   GMAIL_REFRESH_TOKEN_<credentials_ref>   (refresh token)
#   GMAIL_USER_EMAIL_<credentials_ref>      (gmail account address; defaults to "me")

# Runtime
HEALTH_PORT=8081
LOG_LEVEL=INFO
GRACEFUL_SHUTDOWN_SECONDS=30
