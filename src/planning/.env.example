# Broker
BROKER_TYPE=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=email_outreach.events

# Mongo
MONGO_URL=mongodb://mongo:27017
MONGO_DB=email_outreach

# Queues
PLAN_REQUESTED_QUEUE=plan.requested
PLAN_READY_QUEUE=plan.ready

# LLM — provider-prefixed model string, see https://docs.litellm.ai/docs/providers
LLM_MODEL=gemini/gemini-1.5-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Provider keys — LiteLLM picks the right one based on LLM_MODEL prefix
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Runtime
HEALTH_PORT=8080
LOG_LEVEL=INFO
RABBIT_PREFETCH=10
GRACEFUL_SHUTDOWN_SECONDS=30
