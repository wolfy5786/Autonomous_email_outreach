# Prospecting service runtime configuration
# Copy this file to .env and adjust values for your environment.

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
RABBITMQ_EXCHANGE=email_outreach.events
RABBITMQ_PREFETCH=10
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/

# MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=email_outreach

# App startup / HTTP
WAIT_FOR_DEPS=true
STARTUP_RETRIES=45
STARTUP_SLEEP_SECONDS=2
HTTP_HOST=0.0.0.0
HTTP_PORT=8004

# Prospecting logic
DEFAULT_MIN_ICP_SCORE=0.0

# Test runner / local service URL
SERVICE_URL=http://prospecting:8004
